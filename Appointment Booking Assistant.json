        "text": "=Current date and time: {{ $now }}\n\nCustomer message: {{ $json.Message }}\n\nExtract the appointment date and time from this message.\nThe customer may write in English, Urdu, or Roman Urdu.\nReturn only this JSON and nothing else:\n{\"date\": \"YYYY-MM-DD\", \"time\": \"HH:MM\"}\n\nIf the message does not contain a clear date or time, return exactly:\n{\"date\": null, \"time\": null}",
        "batching": {}
      },
