    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || '';\nconst form = $('On form submission').first().json;\n\nlet data = {};\ntry {\n  const clean = raw.replace(/```json|```/g, '').trim();\n  data = JSON.parse(clean);\n} catch (e) {\n  data = {};\n}\n\nlet valid = Boolean(\n  data.date && data.time &&\n  /^\\d{4}-\\d{2}-\\d{2}$/.test(data.date) &&\n  /^\\d{2}:\\d{2}$/.test(data.time)\n);\n\nlet start = '';\nlet end = '';\n\nif (valid) {\n  const s = new Date(`${data.date}T${data.time}:00+05:00`);\n  if (isNaN(s.getTime())) {\n    valid = false;\n  } else {\n    start = s.toISOString();\n    end = new Date(s.getTime() + 60 * 60 * 1000).toISOString();\n  }\n}\n\nreturn [{\n  json: {\n    name: form.Name,\n    message: form.Message,\n    date: data.date || '',\n    time: data.time || '',\n    start,\n    end,\n    valid\n  }\n}];"
      },
